# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.

# --- Email (Resend) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# The inbox that should receive contact/application form submissions
CONTACT_INBOX=admissions@heliosrecovery.com
# Optional: verified sender. Requires the domain to be verified in Resend.
# Falls back to onboarding@resend.dev when unset.
# EMAIL_FROM=Helios Recovery Residences <admissions@heliosrecoveryresidences.com>

# --- Card payments (Stripe) ---
# Use test values locally and separate live values in production. Checkout is a
# hosted redirect, so there is no publishable key and no card data on our side.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook. Subscribe to checkout.session.completed,
# checkout.session.async_payment_succeeded, refund.created, refund.updated,
# refund.failed, charge.dispute.created, charge.dispute.updated, and
# charge.dispute.closed.
STRIPE_WEBHOOK_SECRET=
# Server-only Payment Method Configuration for rent. Enable card/Link and keep
# Affirm/Klarna off. Use a separate pmc_ value for test and live modes.
STRIPE_RENT_PAYMENT_METHOD_CONFIGURATION_ID=
# Publishable key matching the secret key above (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- SMS (Telnyx) ---
# V2 API key. The value shown when you re-open a key is only its ID; the full
# secret (KEY<hex>_<secret>) is displayed once at creation.
TELNYX_API_KEY=
# Sending number in E.164, e.g. +15555550100
TELNYX_FROM_NUMBER=

# --- Resident portal sessions ---
# 32-byte base64url pepper for hashing SMS passcodes and session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this signs every resident out.
RESIDENT_AUTH_SECRET=

# --- Web push (VAPID) ---
# Generate a pair: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Rotating these invalidates every existing push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto: for push services
VAPID_SUBJECT=

# --- Database / Auth (Supabase) ---
# Project Settings → Data API  (safe to expose — used in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://usbiuhldjsvvvfngztsu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API Keys → service_role  (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# Connect → ORM/Drizzle → Session pooler connection string (SECRET — has password)
DATABASE_URL=
